# --- Server ---
PORT=3002
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# SQLite database path (created automatically)
DB_PATH=./server/database/steamprofiles.db

# Steam Web API key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY=

# Webshare rotating proxies (text file in repo root by default)
WEBSHARE_PROXY_FILE=./Webshare 10 proxies.txt

# Suborbit rotating proxy (for community inventory fetches)
SUBORBIT_USERNAME=
SUBORBIT_PASSWORD=
SUBORBIT_HOST=
SUBORBIT_PORT=

# Tuning
MAX_STEAM_API_CONCURRENCY=120
MAX_INVENTORY_CONCURRENCY=20
DEFAULT_BATCH_SIZE=75
PROFILE_CACHE_EXPIRY_MINUTES=60
CASE_PRICE_EXPIRY_HOURS=24
ITEM_PRICE_EXPIRY_DAYS=7

LOG_LEVEL=info
ENABLE_FILE_LOGGING=0

# --- Client ---
# Used by Vite (must be prefixed VITE_)
VITE_API_URL=http://localhost:3002
